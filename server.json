{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.mkpvishnu/terminal-mcp",
  "description": "MCP server for interactive terminal sessions — SSH, REPLs, database CLIs, TUI apps",
  "repository": {
    "url": "https://github.com/mkpvishnu/terminal-mcp",
    "source": "github"
  },
  "version": "0.3.2",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "terminal-mcp",
      "version": "0.3.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Maximum concurrent sessions",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "TERMINAL_MCP_MAX_SESSIONS"
        },
        {
          "description": "Seconds before auto-close (default 1800)",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "TERMINAL_MCP_IDLE_TIMEOUT"
        }
      ]
    }
  ]
}
